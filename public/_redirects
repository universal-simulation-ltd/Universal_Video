# Cloudflare Pages rewrites — Universal Video is served under /video/ but the
# built files in dist/ are flat (Vite's `base` only rewrites URLs INSIDE the
# HTML; it does not place files in dist/video/).
#
# 200 status = transparent rewrite (URL bar unchanged). Specific rules first,
# broad SPA fallback last.

# Service-worker + PWA artefacts.
/video/sw.js              /sw.js                200
/video/registerSW.js      /registerSW.js        200
/video/manifest.webmanifest /manifest.webmanifest 200
/video/workbox-*          /workbox-:splat       200

# Hashed asset bundles.
/video/assets/*           /assets/:splat        200

# Static files referenced from index.html / app code (BASE_URL-prefixed).
/video/favicon.svg        /favicon.svg          200
/video/unisim-icon.png    /unisim-icon.png      200
/video/icon-180.png       /icon-180.png         200
/video/icon-192.png       /icon-192.png         200
/video/icon-512.png       /icon-512.png         200

# The example clip. ⚠️ It NEEDS a rule of its own, like every other file in
# `public/`: `dist/` is flat, so without one the SPA fallback below answers
# `/video/Example_Video.mp4` with index.html — status 200, content-type
# text/html — and the app reports the file it ships itself as "no MP4 movie
# header… may be corrupt". Which is exactly what it did, in production, for the
# hour this line was missing. Universal Images has had the same line for its
# example image since the day it shipped one.
/video/Example_Video.mp4  /Example_Video.mp4    200

# SEO crawler files.
/video/robots.txt         /robots.txt           200
/video/sitemap.xml        /sitemap.xml          200

# SPA fallback — everything else under /video/ serves the shell.
/video/*                  /index.html           200
